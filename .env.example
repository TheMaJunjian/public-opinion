# npm run dev loads .env when present. Shell variables take precedence.
HOST=127.0.0.1
PORT=3000
# npm run dev starts this local Docker database automatically.
# Set another PostgreSQL URL to use an existing database instead.
DATABASE_URL=postgresql://gonglun:gonglun_dev@127.0.0.1:54329/gonglun
# Optional when automatically importing Prisma data; defaults to its earliest user.
# GONGLUN_LEGACY_FOUNDER_ID=existing-user-id
# Required only for the first registration when NODE_ENV=production.
GONGLUN_FOUNDER_KEY=replace-with-a-long-random-key
# Set to 1 only when the server is behind one trusted reverse proxy.
# TRUST_PROXY=1
