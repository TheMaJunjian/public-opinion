# Local development uses these defaults; set variables in the shell before npm start.
HOST=127.0.0.1
PORT=3000
GONGLUN_DB=data/gonglun.sqlite
# Required only for the first registration when NODE_ENV=production.
GONGLUN_FOUNDER_KEY=replace-with-a-long-random-key
# Set to 1 only when the server is behind one trusted reverse proxy.
# TRUST_PROXY=1
