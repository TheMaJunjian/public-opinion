generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  publicKey String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  topics            Topic[]
  messages          Message[]
  auditLogs         AuditLog[]
  pointAccount      PointAccount?
  pointTransactions PointTransaction[]
  balance           Balance?
  ledgerEntries     LedgerEntry[]
  stakes            Stake[]
  settlementRounds  SettlementRound[]
  voteStakes        VoteStake[]
}

model Topic {
  id          String      @id @default(cuid())
  title       String
  body        String?
  status      TopicStatus @default(OPEN)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  createdById String
  createdBy   User        @relation(fields: [createdById], references: [id])

  messages  Message[]
  auditLogs AuditLog[]
}

enum TopicStatus {
  OPEN
  ARCHIVED
}

enum MessageKind {
  TEXT
  RELATION
}

model Message {
  id          String      @id @default(cuid())
  topicId     String
  createdById String
  kind        MessageKind @default(TEXT)
  createdAt   DateTime    @default(now())

  // TEXT kind fields
  contentType         ContentType?
  content             String?
  quoteSourceId       String?
  quotedText          String?
  quotedTextHash      String?
  quoteContextBefore  String?
  quoteContextAfter   String?

  // RELATION kind fields
  relationType  String?
  relSourceId   String?
  targetRefs    Json?
  relationPayload Json?
  supersededBy  String?

  topic     Topic    @relation(fields: [topicId], references: [id])
  createdBy User     @relation(fields: [createdById], references: [id])

  stakes         Stake[]
  betPool        BetPool?
  settlementRounds SettlementRound[]
}

enum ContentType {
  TEXT
  MARKDOWN
}

// ============================================================
// Audit & Governance Models (Phase 1 — pre-decentralization foundation)
// ============================================================

model AuditLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  entityType String
  entityId   String?
  topicId    String?
  topic      Topic?   @relation(fields: [topicId], references: [id])
  data       Json?
}

model RuleVersion {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  version     Int
  status      String   @default("ACTIVE") // ACTIVE | SUPERSEDED
  description String?
  parameters  Json
}

// ============================================================
// Points & Ledger Models (Phase 1 — 贡献点与账本)
// ============================================================

model PointAccount {
  userId    String @id
  user      User   @relation(fields: [userId], references: [id])
  available Int    @default(0)
  locked    Int    @default(0)
}

model PointTransaction {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  type         String   // MINT | UNLOCK | LOCK | SPEND | TRANSFER
  amount       Int
  balanceAfter Int
  createdAt    DateTime @default(now())
  data         Json?
}

model Balance {
  userId      String  @id
  user        User    @relation(fields: [userId], references: [id])
  balance     Int     @default(0)
  debtFrozen  Boolean @default(false)
  totalLost   Int     @default(0)  // cumulative permanently lost stakes & votes
  totalEarned Int     @default(0)  // cumulative net profit from settlements
}

model LedgerEntry {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  entryType    String   // MINT_INITIAL | MINT_DAILY | STAKE_LOCK | STAKE_UNLOCK | VOTE_LOCK | VOTE_UNLOCK | SETTLEMENT_PAYOUT | SETTLEMENT_CLAWBACK
  amount       Int
  balanceAfter Int
  roundId      String?
  messageId    String?
  createdAt    DateTime @default(now())
  data         Json?
}

// ============================================================
// Stake & BetPool Models (Phase 2 — 押注与资金池)
// ============================================================

model Stake {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  topicId   String
  messageId String
  message   Message  @relation(fields: [messageId], references: [id])
  side      String   // PRO | CON
  amount    Int
  roundId   String?
  createdAt DateTime @default(now())
}

model BetPool {
  messageId String @id
  message   Message @relation(fields: [messageId], references: [id])
  lockedPro Int    @default(0)
  lockedCon Int    @default(0)
}

// ============================================================
// Settlement Models (Phase 3 — 结算轮次与投票)
// ============================================================

model SettlementRound {
  id               String   @id @default(cuid())
  messageId        String
  message          Message  @relation(fields: [messageId], references: [id])
  createdByUserId  String
  createdBy        User     @relation(fields: [createdByUserId], references: [id])
  status           String   @default("OPEN") // OPEN | VOTING | SETTLED | CANCELLED
  result           String?  // TRUE | FALSE | UNKNOWN
  previousRoundId  String?
  previousRound    SettlementRound? @relation("RoundChain", fields: [previousRoundId], references: [id])
  nextRounds       SettlementRound[] @relation("RoundChain")
  openedAt         DateTime @default(now())
  closedAt         DateTime?
  note             String?

  votes VoteStake[]
}

model VoteStake {
  id        String   @id @default(cuid())
  roundId   String
  round     SettlementRound @relation(fields: [roundId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  vote      String   // TRUE | FALSE | UNKNOWN
  amount    Int
  createdAt DateTime @default(now())
}
