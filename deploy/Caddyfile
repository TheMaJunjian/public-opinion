{$DOMAIN} {
	# All API responses, including SSE, are streamed without proxy caching.
	@api path /api /api/*
	handle @api {
		reverse_proxy app:3000 {
			# Caddy flushes text/event-stream immediately and cancels on disconnect.
			header_down Cache-Control "no-store, no-cache, must-revalidate, no-transform"
			header_down X-Accel-Buffering "no"
		}
	}

	# The application serves apps/web/dist and its SPA fallback on the same origin.
	handle {
		reverse_proxy app:3000
	}
}
