{
  "name": "gonglun",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/server",
    "packages/core",
    "frontend"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch apps/server/src/main.ts",
    "dev:web": "npm --workspace frontend run dev",
    "typecheck": "tsc --noEmit && npm --workspace frontend run typecheck",
    "build": "npm run typecheck && npm --workspace frontend run build && esbuild apps/server/src/main.ts --bundle --platform=node --format=esm --external:express --external:zod --outfile=apps/server/dist/main.js",
    "start": "node apps/server/dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/express": "^4.17.23",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.9",
    "jsdom": "^26.1.0",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.0",
    "vitest": "^5.0.4"
  }
}
